<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level] [%logger]: %msg%n"/></Console>
    <!-- Forge replaces this configuration with its own rolling logs during launch. -->
    <File name="BootstrapDebug" fileName="logs/bootstrap-debug.log" append="false"><PatternLayout pattern="[%d{HH:mm:ss.SSS}] [%t/%level] [%logger]: %msg%n"/></File>
  </Appenders>
  <Loggers><Root level="debug"><AppenderRef ref="Console" level="info"/><AppenderRef ref="BootstrapDebug"/></Root></Loggers>
</Configuration>
