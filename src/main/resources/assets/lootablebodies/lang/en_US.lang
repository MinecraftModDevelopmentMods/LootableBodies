entity.lootablebodies.Corpse.name=Corpse

lootablebodies.config.local_file=Settings for this installation
lootablebodies.config.appearance=Appearance
lootablebodies.config.appearance.tooltip=Local display preferences. Save with Done to apply to this client.
lootablebodies.config.rules=World/server rules (restart required)
lootablebodies.config.rules.tooltip=Local singleplayer and server rules. Restart Minecraft to apply. A remote server uses its own configuration file; these controls do not change it. Rules cannot be edited while a world is open.
lootablebodies.config.local_texture=Use generic corpse texture
lootablebodies.config.local_texture.tooltip=Use the bundled corpse texture instead of player skins. Affects only your view.
lootablebodies.config.display_nametag=Show owner names
lootablebodies.config.display_nametag.tooltip=Show names above corpses. Affects only your view.
lootablebodies.config.corpse_HP=Corpse health
lootablebodies.config.corpse_HP.tooltip=Damage needed to destroy a corpse and release its items. 20 HP is 10 hearts. Used when corpse damage is enabled; existing saved health is preserved. Requires a restart.
lootablebodies.config.add_bones_to_corpse=Add bones and rotten flesh
lootablebodies.config.add_bones_to_corpse.tooltip=Add bones and rotten flesh on death. These items keep a corpse nonempty until removed, which delays empty-only decay. Requires a restart.
lootablebodies.config.item_decay_rate=Item wear interval (minutes)
lootablebodies.config.item_decay_rate.tooltip=Damageable items lose one durability point per interval, but are never completely destroyed by this wear. Default: 5 minutes. Zero or negative disables wear. Requires a restart.
lootablebodies.config.hurt_by_environment=Damage from environmental hazards
lootablebodies.config.hurt_by_environment.tooltip=Allow fire, lava, falls and similar hazards to damage corpses. Requires a restart.
lootablebodies.config.hurt_by_weapons=Damage from attacks
lootablebodies.config.hurt_by_weapons.tooltip=Allow attacks to damage corpses. Requires a restart.
lootablebodies.config.hurt_by_misc=Damage from other sources
lootablebodies.config.hurt_by_misc.tooltip=Allow damage sources outside the other two groups. Corpses are invulnerable when all three damage settings are disabled. Requires a restart.
lootablebodies.config.enable_corpse_decay=Enable corpse decay
lootablebodies.config.enable_corpse_decay.tooltip=Remove corpses after the configured lifetime. Default: enabled, but only while empty. Requires a restart.
lootablebodies.config.empty_only_decay=Decay only while empty
lootablebodies.config.empty_only_decay.tooltip=Count lifetime only while a corpse is empty. Added bones and rotten flesh count as items. Used only when corpse decay is enabled. Requires a restart.
lootablebodies.config.corpse_decay_time=Corpse lifetime (hours:minutes:seconds)
lootablebodies.config.corpse_decay_time.tooltip=Enter hours:minutes or hours:minutes:seconds using nonnegative whole numbers. Default: 1:00:00; minimum effective time: 2 seconds. Invalid or overflowing input is not saved. Used only when corpse decay is enabled. Requires a restart.
